PROJECT_NAME=MM-Agent Open Local Service
SECRET_KEY=change-me-before-public-deploy

# Local auth and registration
ALLOW_PUBLIC_REGISTRATION=true
REQUIRE_INVITE_CODE=false
SEED_LOCAL_ADMIN=true
LOCAL_ADMIN_EMAIL=admin@local.dev
LOCAL_ADMIN_PASSWORD=admin12345

# Local persistence
DATABASE_URL=sqlite+aiosqlite:///./runtime/mmagent.db
REDIS_URL=
STORAGE_ROOT=runtime/storage/blobs

# Direct LLM / router configuration
API_KEY=
BASE_URL=https://api.openai.com/v1
MODEL_NAME=gpt-4o-mini
AGENT_MODEL_NAME=gpt-4o-mini
USE_LLM_ROUTER=true

# Optional provider-specific fallbacks
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
TAVILY_API_KEY=

# Required for sandbox-backed execution and paper engine
E2B_API_KEY=
